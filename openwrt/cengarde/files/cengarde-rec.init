#!/bin/sh /etc/rc.common
# The field recorder (/usr/sbin/cengarde-rec, story 012), off unless
# /etc/config/cengarde has a section "recorder" with enabled 1. It keeps the
# engine's status file once a second in hourly gzip files, capped in size.

START=99
STOP=05
USE_PROCD=1

start_service() {
	local enabled dir max_mb

	config_load cengarde
	config_get_bool enabled recorder enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get dir recorder dir /tmp/cengarde-rec
	config_get max_mb recorder max_mb 64
	procd_open_instance
	procd_set_param command /usr/sbin/cengarde-rec -d "$dir" -m "$max_mb"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cengarde
}
