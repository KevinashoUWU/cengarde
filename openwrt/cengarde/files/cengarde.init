#!/bin/sh /etc/rc.common
# cengarde (client or server, as set in the configuration file).
# Edit /etc/cengarde/cengarde.conf, check it with
#   cengarde -t -c /etc/cengarde/cengarde.conf
# then: /etc/init.d/cengarde enable && /etc/init.d/cengarde start
# Logs: logread -e cengarde. Status: cat /var/run/cengarde.json

START=90
STOP=10
USE_PROCD=1

PROG=/usr/sbin/cengarde
CONF=/etc/cengarde/cengarde.conf

start_service() {
	if grep -q '^key = REPLACE_WITH' "$CONF"; then
		logger -t cengarde "not started: set key and server in $CONF first"
		return 1
	fi
	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF"
	# Retry every 5 s, forever: at boot the server name may not resolve yet
	# (an IP address in "server" avoids the wait).
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	# "reload" restarts it when the file changed.
	procd_set_param file "$CONF"
	procd_close_instance
}
