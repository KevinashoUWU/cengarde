#!/bin/sh /etc/rc.common
# cengarde, configured in /etc/config/cengarde (LuCI: Services > cengarde).
# Every start and reload runs "cengarde-setup apply" (tunnel, firewall,
# uplinks, UPnP) and regenerates the client configuration; procd restarts
# the engine only when that configuration changed. With config_file set, the
# engine runs that file instead (a server, for instance).

START=90
STOP=10
USE_PROCD=1
PROG=/usr/sbin/cengarde
SETUP=/usr/sbin/cengarde-setup
CONF=/var/etc/cengarde.conf

start_service() {
	local enabled config_file

	$SETUP apply
	config_load cengarde
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get config_file main config_file
	if [ -z "$config_file" ]; then
		mkdir -p /var/etc
		if ! (umask 077 && $SETUP engine-conf > "$CONF.new"); then
			rm -f "$CONF.new"
			return 1
		fi
		mv "$CONF.new" "$CONF"
		config_file=$CONF
	fi
	procd_open_instance
	procd_set_param command "$PROG" -c "$config_file"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$config_file"
	procd_close_instance
}

add_uplink_trigger() {
	procd_add_interface_trigger "interface.*" "$1" /etc/init.d/cengarde reload
}

service_triggers() {
	procd_add_reload_trigger cengarde
	# An uplink's device may only be known once it is up.
	config_load cengarde
	config_list_foreach main uplink add_uplink_trigger
}
