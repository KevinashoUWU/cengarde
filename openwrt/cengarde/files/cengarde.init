#!/bin/sh /etc/rc.common
# cengarde, configured in /etc/config/cengarde (LuCI: Services > cengarde).
# Every start and reload runs "cengarde-setup apply" (tunnel, firewall,
# uplinks, UPnP) and regenerates the client configuration. When that changed,
# procd sends the engine SIGHUP: it applies the new configuration without
# dropping the tunnel (and restarts itself in place for the few settings that
# need it). With config_file set, the engine runs that file instead (a
# server, for instance), through the same path.

START=90
STOP=10
USE_PROCD=1
PROG=/usr/sbin/cengarde
SETUP=/usr/sbin/cengarde-setup
CONF=/var/etc/cengarde.conf

start_service() {
	local enabled config_file

	$SETUP apply
	config_load cengarde
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get config_file main config_file
	mkdir -p /var/etc
	if [ -n "$config_file" ]; then
		# The command line never changes, so procd always signals instead
		# of restarting: a new path would otherwise go unnoticed.
		ln -sf "$config_file" "$CONF"
	elif (umask 077 && $SETUP engine-conf > "$CONF.new"); then
		mv "$CONF.new" "$CONF"
	else
		rm -f "$CONF.new"
		return 1
	fi
	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF"
	procd_set_param reload_signal HUP
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}

add_uplink_trigger() {
	procd_add_interface_trigger "interface.*" "$1" /etc/init.d/cengarde reload
}

service_triggers() {
	local i

	procd_add_reload_trigger cengarde
	# An uplink's device may only be known once it, or its IPv6 companion
	# when its IPv4 is down, is up. Nothing in apply depends on that state,
	# so these reloads change nothing but the engine configuration.
	config_load cengarde
	config_list_foreach main uplink add_uplink_trigger
	for i in $($SETUP companions); do
		add_uplink_trigger "$i"
	done
}
