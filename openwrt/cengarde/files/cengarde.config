# cengarde: LuCI (Services > cengarde) edits this file. After a change by
# hand: /etc/init.d/cengarde reload
config cengarde 'main'
	option enabled '0'
	# Pairing secret shared with the VPS (generated on install; every key
	# derives from it). The VPS gets it in its cloud-config.
	option secret ''
	# Public IP (or name) and UDP port of the VPS.
	option server ''
	option port '65500'
	# Uplinks to bond: logical interfaces from /etc/config/network.
	#list uplink 'wan'
	# Create and maintain the WireGuard interface "wgcg" (10.79.0.2/30) and
	# route all traffic through it.
	option tunnel '1'
	option route_all '1'
	option mtu '1380'
	list dns '1.1.1.1'
	list dns '9.9.9.9'
	# IP pass: the VPS forwards ports 1024-65000 here and UPnP hands them
	# on to the LAN (needs miniupnpd-nftables).
	option ip_pass '0'
	option log_level 'info'
	# Engine settings (engine/examples/client.conf), unset = default:
	#option mute_behind_ms '150'
	#option mute_settle_ms '2000'
	#option min_active_links '2'
	#option probe_interval_ms '100'
	#option busy_poll_us '0'
	# A hand-written engine configuration instead of the generated one:
	#option config_file '/etc/cengarde/cengarde.conf'
