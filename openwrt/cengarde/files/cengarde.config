# cengarde: LuCI (Services > cengarde) edits this file. After a change by
# hand: /etc/init.d/cengarde reload
config cengarde 'main'
	option enabled '0'
	# Pairing secret shared with the VPS (generated on install; every key
	# derives from it). The VPS gets it in its cloud-config.
	option secret ''
	# This router's name on the VPS (1 to 12 characters of a-z, 0-9 and -,
	# not starting with -, and not "default"; unset: router). Routers that
	# share a VPS need different names.
	#option vps_name 'router'
	# This router's address in the tunnel: 10.79.X.Y from 10.79.0.2 to
	# 10.79.255.254 (10.79.0.1 is the VPS), different on each router of a VPS.
	# Unset or empty: the one derived from the secret (cengarde keys). The VPS
	# gets it from the cloud-config or from cengarde-vps-setup add NAME
	# --tunnel-addr ADDR (LuCI shows both). A router that had a secret before
	# 0.5.2 has 10.79.0.2, the address its VPS knows; another one cuts the
	# tunnel until the VPS gets it too.
	#option tunnel_addr '10.79.0.2'
	# Public addresses of the VPS, IPv4 and IPv6, in order of preference (at
	# most 8), and its UDP port. Each uplink uses the first one of a family
	# it has, and moves on to the next when the VPS stops answering there.
	# A name works too: the engine looks it up through the uplinks (their
	# DNS servers first, never through the tunnel) and follows its IP.
	#list server '203.0.113.10'
	#list server '2001:db8::4'
	#list server 'vps.example.com'
	option port '65500'
	# bonding adds the uplinks up (each large packet on the uplink where it
	# arrives first, each uplink its own rate, the TCP as GRIT); redundancy
	# copies every packet over every uplink that delivers it in time by its
	# own rate (the TCP as GRIT too);
	# custom (or no mode, as before) takes every
	# option below as set. Bonding and redundancy own split, protocontroller,
	# subflow and link_cc, and bring defaults that an option set apart wins.
	# The VPS follows with "cengarde-vps-setup mode bonding|redundancy".
	option mode 'bonding'
	# This router administers the VPS, whose settings every router there
	# shares (LuCI's VPS tab): its mode goes there on each change. Its key,
	# /etc/cengarde/vps_admin_key, made by "cengarde-setup vps-key", which
	# prints the line for "cengarde-vps-setup admin-key add" on the VPS; then
	# "cengarde-setup vps get|mode|fec|protocontroller|set|unset ...". SSH to
	# vps_ssh_host (unset: the first server) at vps_ssh_port (22).
	#option vps_admin '1'
	#option vps_ssh_host '203.0.113.10'
	#option vps_ssh_port '22'
	# Uplinks to bond: logical interfaces from /etc/config/network.
	#list uplink 'wan'
	# The kind of link each uplink is, UPLINK=TYPE with TYPE auto (the
	# default), cellular, starlink, fiber, ethernet or radio. The engine
	# tunes how it measures and fills each uplink to its type, and tells the
	# VPS so the download is treated alike. Today only starlink changes
	# anything, and only with split_eta: it drops instead of queueing when
	# full, so it is held to the queue it showed and the rest goes on the
	# other uplinks while they deliver it in time. The others behave as auto
	# until measured.
	#list uplink_type 'wan=starlink'
	# A DHCPv6 interface "<uplink>6" on each DHCP or static uplink, so that
	# cengarde sees the IPv6 of the modems; their prefix never reaches the
	# LAN. With route_all, existing IPv6 interfaces of the uplinks (wan6)
	# stop handing their prefix to the LAN too, whatever this says.
	option uplink_ipv6 '1'
	# Create and maintain the interface "cg0" on the engine's own TUN (the
	# address above as a /32, and a route to the VPS end of the tunnel,
	# 10.79.0.1) and route all traffic through it. The engine carries the IP
	# packets itself: authenticated (nobody can inject or replay them) but
	# NOT encrypted, so the carriers see the traffic.
	option tunnel '1'
	option route_all '1'
	# IPv6 inside the tunnel (off until tested on real hardware): cg0 also
	# gets a ULA address derived from the secret (cengarde keys) and a route
	# to the VPS end of that prefix; with route_all, all the IPv6 of the
	# router and the LAN goes through the tunnel, translated (NAT66) here and
	# at the VPS. The VPS needs IPv6 and "sudo cengarde-vps-setup ipv6 on"
	# (the cloud-config of a new VPS follows this switch). The LAN needs a ULA
	# prefix (Network > Interfaces > Global network options), and a device
	# that has only that prefers IPv4 for a name that has both: this serves
	# IPv6-only sites.
	option tunnel_ipv6 '0'
	# At most 1444 over IPv4 and 1424 over IPv6 (a 1500-byte path).
	option mtu '1380'
	# Only the IPv4 ones (IPv6 servers are left out even with tunnel_ipv6).
	list dns '1.1.1.1'
	list dns '9.9.9.9'
	# IP pass: the VPS forwards ports 1024-65000 here and UPnP hands them
	# on to the LAN (needs miniupnpd-nftables).
	option ip_pass '0'
	# Only for IP pass when no VPS address is IPv4: UPnP learns the
	# public IPv4 from this STUN server through the tunnel (port: 3478 if
	# unset). Without it UPnP announces no IP and hands no ports on.
	#option stun_host 'stun.cloudflare.com'
	#option stun_port '3478'
	option log_level 'info'
	# How the engine reads the uplinks: legacy, the code of every release
	# so far (the default until the threads are measured on the Pi); on, a
	# thread per uplink, so that a stalled uplink or thread no longer holds
	# back the others (more CPU at low traffic); off, the new structure in
	# one thread. A change restarts the engine.
	option link_threads 'legacy'
	# Engine settings (engine/examples/client.conf), unset = default. The
	# failover time is 0 (never) or at least 3 x the larger of 1000 and the
	# probe interval:
	#option server_failover_ms '10000'
	#option mute_behind_ms '150'
	#option mute_settle_ms '2000'
	#option min_active_links '2'
	#option probe_interval_ms '100'
	#option probe_idle_ms '1000'
	#option status_interval_ms '1000'
	#option busy_poll_us '0'
	# Reordering at the receiver (on unless 0; the VPS does the same with what
	# it receives): a packet that arrives ahead of a missing one waits at most
	# reorder_max_wait_ms (0-2000), less once the slowest uplink would have
	# delivered the missing one (plus reorder_margin_ms, 0-1000). Packets of up
	# to reorder_bypass bytes (0-2048: keepalives, empty ACKs) and the
	# handshakes are never held. Where nothing is split the wait is
	# reorder_dup_wait_ms (0 to reorder_max_wait_ms; 0 holds nothing there).
	# reorder_pool_kb (256-131070) is the memory for held packets: changing it
	# restarts the engine.
	#option reorder '1'
	#option reorder_max_wait_ms '200'
	#option reorder_dup_wait_ms '0'
	#option reorder_margin_ms '10'
	#option reorder_bypass '128'
	#option reorder_pool_kb '8192'
	# EXPERIMENTAL: a gap waits only as long as the uplink it went on takes,
	# and is given up once that uplink brings a later packet.
	#option reorder_by_link '0'
	# EXPERIMENTAL: each uplink's wait for a missing packet learns from the
	# packets that came after it was given up.
	#option reorder_adaptive '0'
	# EXPERIMENTAL: ask the VPS for a missing packet before giving it up
	# (the VPS needs rescue_kb), waiting this long for it (0-1000; 0: never),
	# asking up to rescue_tries times (1-4). rescue_kb (0: none) keeps what
	# goes up so the VPS can ask for it; rescue_pct (1-50) is its budget.
	#option rescue_wait_ms '0'
	#option rescue_tries '2'
	#option rescue_kb '0'
	#option rescue_pct '5'
	# The rescue in one switch (LuCI's Protection tab): rescue_wait_ms 60 and
	# rescue_kb 32768 unless those are set apart.
	#option rescue '0'
	# The protection of the upload while every uplink carries it (stories 020
	# and 021): no (full copies), mix, parity, rlc, rs or copies; every mode
	# but no needs "fec = yes" on the VPS. redund_spare_first: the uplink that
	# carries every packet (empty: the least delay not choked).
	#option redund_spare 'no'
	#option redund_spare_first ''
	# With a Starlink uplink, the others copy a packet only if it arrives
	# within this long of the first (0-2000; empty: 60, the Starlink preset;
	# 250 worked in the field).
	#option pace_peers_ms ''
	# Native mode: ACKs and handshakes of the TCP inside are not held, and a
	# TCP retransmission is copied over every uplink only when the original
	# was lost on all of them.
	#option tcp_aware '0'
	# EXPERIMENTAL: send each packet larger than split_small bytes (0-2048)
	# over one uplink, chosen by weight, instead of a copy over all of them.
	# It adds up the uplinks (two equal ones carried 1.98 times one in the
	# lab) but protects less than copying: an uplink that dies keeps its share
	# until the engine takes it out, the slowest uplink with a weight sets the
	# latency, and a weight above what an uplink carries fills its modem's
	# queue. The VPS follows the router (it splits the download with the same
	# weights; nothing to set there). split_weight is NAME=WEIGHT, NAME an
	# uplink from the list above and WEIGHT from 0 to 1000 (1 if unset; 0: the
	# uplink also carries a copy of every packet that is split).
	# split_spread_ms (0-2000): an uplink more than this behind the fastest
	# one (its delay towards the VPS) loses its share until it stays within
	# 3/4 of it for mute_settle_ms; 0: no limit. In the lab 50 ms between two
	# uplinks already lost most of the split's gain. split_spread_copy: 1 (as
	# up to 0.6.2) gives an uplink out of the split a copy of every packet,
	# and with fewer than 2 uplinks left everything goes to every uplink; 0
	# gives it only what goes to every uplink (handshakes, small packets),
	# and one uplink left takes every split packet. Only for the upload: the
	# VPS has its own (cengarde.conf there).
	#option split '0'
	#option split_small '256'
	#list split_weight 'wan=2'
	#option split_spread_ms '30'
	#option split_spread_copy '1'
	# Repair data with the split, or on a lone uplink (fec; the VPS needs
	# "sudo cengarde-vps-setup fec on" to rebuild it). fec_code xor: the
	# parity of each group of split packets, one per uplink (rebuilds one
	# loss per group); rlc (FEC v3, story 026): repairs over a sliding window
	# of every packet sent in the last fec_window_ms (10-1000), fec_pct
	# (1-50) % of the bytes at most, spread over the uplinks by their share,
	# so an uplink that stalls is rebuilt from what the others carry; all of
	# it for 30 s after a burst, 25 times a random loss, fec_pct_min (0-50)
	# when nothing is lost but a full queue's drops. fec_single:
	# on a lone uplink, auto protects it while it loses at random (as
	# Starlink does; not when its queue overflows), yes always, no never.
	#option fec '0'
	#option fec_code 'xor'
	#option fec_pct '20'
	#option fec_pct_min '0'
	#option fec_window_ms '300'
	#option fec_single 'auto'
	# governor (experimental): each uplink's share of the upload split from
	# its own queue (its delay over its minimum of the last
	# governor_window_ms): down while it holds more than governor_target_ms,
	# up while it holds less than half. Weights of 0 stay copies. The VPS
	# has its own, for the download (governor = yes in its cengarde.conf).
	#option governor '0'
	#option governor_target_ms '20'
	#option governor_window_ms '10000'
	# The protocontroller (story 025; the VPS needs it on too: "sudo
	# cengarde-vps-setup protocontroller on"): no, the tunnel as always; a or
	# b, the router answers the LAN's TCP itself and the VPS opens a fresh TCP
	# to the destination (cubic, BBR once that leg loses).
	# Between them each connection travels as a plain TCP through the tunnel
	# (a; protocontroller_mid_cc its congestion control, bbr; empty: the kernel's)
	# or, EXPERIMENTAL, as a reliable stream of cengarde's, paced by what the
	# uplinks carry instead of by loss (b). The firewall redirects to the
	# engine the TCP that enters from the LAN to protocontroller_port
	# (empty: every port) and protocontroller_dest (empty: every address
	# that is not private), never the router's own. UDP, QUIC and the rest
	# go through the tunnel as always. protocontroller_buf_kb (64-16368) is
	# each connection's buffer per direction, protocontroller_mem_mb
	# (0-4096; 0: an eighth of the RAM, 64 to 1024) all of them,
	# protocontroller_max_flows (1-65535) the connections at once. A change restarts the engine.
	#option protocontroller 'no'
	#list protocontroller_port '1935'
	#list protocontroller_port '443'
	#list protocontroller_dest '157.240.0.0/16'
	#option protocontroller_mid_cc 'cubic'
	#option protocontroller_buf_kb '1024'
	#option protocontroller_mem_mb '0'
	#option protocontroller_max_flows '256'
	# A hand-written engine configuration instead of the generated one:
	#option config_file '/etc/cengarde/cengarde.conf'

# The field recorder (/etc/init.d/cengarde-rec): the engine's status, every
# second, in hourly gzip files under dir, at most max_mb of them. For a week
# with 5 uplinks (~120 MB), a USB disk instead of /tmp. With probe_idle_ms
# at 100 an idle uplink still answers 10 times a second.
#config recorder 'recorder'
#	option enabled '1'
#	option dir '/tmp/cengarde-rec'
#	option max_mb '64'
