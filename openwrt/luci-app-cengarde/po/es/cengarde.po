msgstr "RTT"

msgid "Behind the fastest"
msgstr "Atraso frente al más rápido"

msgid "From the VPS"
msgstr "Desde el VPS"

msgid "Arrived first"
msgstr "Llegó primero"

msgid "Sent"
msgstr "Enviado"

msgid "Mutes"
msgstr "Silenciados"

