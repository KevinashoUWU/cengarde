#!/bin/sh
# What a router may do on this server with its admin key: the forced command
# of the keys that "cengarde-vps-setup admin-key add" puts in root's
# authorized_keys (command=..., restrict). The router's LuCI (VPS tab) sends
# one of these in SSH_ORIGINAL_COMMAND; anything else is refused, and no
# argument reaches a shell.
#
#   get                       the server's settings that a router can see
#                             and change, as KEY=VALUE lines: its routers,
#                             mode, the FEC and the protocontroller as the
#                             engine has them, keys= (what "set" takes) and
#                             what engine.local sets of those (local.KEY=)
#   mode bonding|redundancy|custom
#   fec on|rlc|off
#   protocontroller on|off    as cengarde-vps-setup's (the engine restarts)
#   set KEY VALUE             KEY = VALUE in engine.local (KEYS below; a
#                             number or a word), then the configuration again
#   unset KEY                 KEY out of engine.local, then the same
#   flows [ENDPOINT CLASS]... the flow_class lines of engine.local replaced
#                             by these (story 031; none: no rules), then
#                             the same; at most 32
#
# Every router of the server shares these settings (no setting a router has
# for itself yet): a key is for the router that administers the server.
#
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
R=${CENGARDE_ROOT:-}
SETUP=${CENGARDE_VPS_SETUP:-cengarde-vps-setup}
ETC=$R/etc/cengarde
NAT_CONF=$ETC/nat.conf
LOCAL_CONF=$ETC/engine.local
ENGINE_CONF=$ETC/cengarde.conf
# The engine's global settings a router may set here (engine/examples/server.conf).
KEYS='fec fec_code fec_pct fec_pct_min fec_window_ms fec_single fec_stream flow_learn rescue_kb rescue_wait_ms rescue_code_ms pace_peers_ms
split_spread_ms split_spread_copy reorder_margin_ms reorder_max_wait_ms governor governor_target_ms
capacity_weights split_eta tcp_aware protocontroller_buf_kb protocontroller_queue_ms parq'

# only_chars WORD SET: whether WORD has nothing but SET's characters (tr's
# notation; brackets as \133 and \135, never in a bracket expression).
only_chars() { [ -z "$(printf '%s' "$1" | tr -d "$2")" ]; }

refuse() {
	echo "cengarde-vps-admin: $*" >&2
	exit 2
}

allowed() {
	local k

	for k in $KEYS; do
		[ "$k" = "$1" ] && return 0
	done
	return 1
}

# kv FILE VAR: VAR's value in a nat.conf (VAR="value"), else empty.
kv() { sed -n "s/^$2=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$1" 2>/dev/null | tail -n 1; }

# ini FILE KEY: KEY's value in an engine file (KEY = value; the last wins).
ini() { sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" 2>/dev/null | tail -n 1; }

cmd_get() {
	local b f k v

	b=$(kv "$NAT_CONF" BONDING)
	echo "version=$(cengarde version 2>/dev/null | head -n 1)"
	# the routers by name (a file of another name there is not one)
	v=$(find "$ETC/clients" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | sed 's|.*/||' |
		grep -xE '[a-z0-9][a-z0-9-]{0,11}' | grep -vx default | sort | tr '\n' ' ')
	echo "routers=${v% }"
	# what cengarde-vps-setup mode leaves
	if [ "$b" = yes ]; then
		echo mode=bonding
	elif [ "$(kv "$NAT_CONF" REDUNDANCY)" = yes ]; then
		echo mode=redundancy
	else
		echo mode=custom
	fi
	# the FEC and the protocontroller as the engine has them, engine.local
	# included
	f=$(ini "$ENGINE_CONF" fec)
	[ "$f" = yes ] && [ "$(ini "$ENGINE_CONF" fec_code)" = rlc ] && f=rlc
	echo "protocontroller=$(case $(ini "$ENGINE_CONF" protocontroller) in '' | no) echo off ;; *) echo on ;; esac)"
	echo "fec=$(case "$f" in yes) echo on ;; rlc) echo rlc ;; *) echo off ;; esac)"
	v=$(echo "$KEYS" | tr '\n' ' ')
	echo "keys=${v% }"
	for k in $KEYS; do
		v=$(ini "$LOCAL_CONF" "$k")
		[ -z "$v" ] || echo "local.$k=$v"
	done
	v=$(sed -n 's/^[[:space:]]*flow_class[[:space:]]*=[[:space:]]*//p' "$LOCAL_CONF" 2>/dev/null | tr '\n' ';')
	echo "flows=${v%;}"
}

# set_flows [ENDPOINT CLASS]...: engine.local's flow_class lines replaced by
# these, then the engine's configuration again.
set_flows() {
	local tmp="$LOCAL_CONF.admin"

	mkdir -p "$ETC"
	: >"$tmp"
	if [ -e "$LOCAL_CONF" ]; then
		grep -v "^[[:space:]]*flow_class[[:space:]]*=" "$LOCAL_CONF" >"$tmp" || :
	fi
	while [ $# -ge 2 ]; do
		echo "flow_class = $1 $2" >>"$tmp"
		shift 2
	done
	chmod 0644 "$tmp"
	mv "$tmp" "$LOCAL_CONF"
	"$SETUP" refresh
}

# set_local KEY [VALUE]: KEY's lines out of engine.local, and KEY = VALUE at
# its end when given; then the engine's configuration again.
set_local() {
	local tmp="$LOCAL_CONF.admin"

	mkdir -p "$ETC"
	: >"$tmp"
	if [ -e "$LOCAL_CONF" ]; then
		grep -v "^[[:space:]]*$1[[:space:]]*=" "$LOCAL_CONF" >"$tmp" || :
	fi
	[ -z "${2:-}" ] || echo "$1 = $2" >>"$tmp"
	chmod 0644 "$tmp"
	mv "$tmp" "$LOCAL_CONF"
	"$SETUP" refresh
}

set -f # no globs in the words below
# shellcheck disable=SC2086 # split on purpose: words, never a shell
set -- ${SSH_ORIGINAL_COMMAND:-}
case ${1:-} in
get)
	[ $# -eq 1 ] || refuse "usage: get"
	cmd_get
	;;
mode)
	[ $# -eq 2 ] || refuse "usage: mode bonding|redundancy|custom"
	case $2 in bonding | redundancy | custom) ;; *) refuse "mode: bonding, redundancy or custom" ;; esac
	exec "$SETUP" mode "$2"
	;;
fec)
	[ $# -eq 2 ] || refuse "usage: fec on|rlc|off"
	case $2 in on | rlc | off) ;; *) refuse "fec: on, rlc or off" ;; esac
	exec "$SETUP" fec "$2"
	;;
protocontroller)
	[ $# -eq 2 ] || refuse "usage: protocontroller on|off"
	case $2 in on | off) ;; *) refuse "protocontroller: on or off" ;; esac
	exec "$SETUP" protocontroller "$2"
	;;
set)
	[ $# -eq 3 ] || refuse "usage: set KEY VALUE"
	allowed "$2" || refuse "set: $2 is not a setting a router may change"
	case $3 in *[!A-Za-z0-9._-]* | '' | -*) refuse "set: $3: a number or a word" ;; esac
	[ ${#3} -le 16 ] || refuse "set: $3: too long"
	set_local "$2" "$3"
	;;
unset)
	[ $# -eq 2 ] || refuse "usage: unset KEY"
	allowed "$2" || refuse "unset: $2 is not a setting a router may change"
	set_local "$2"
	;;
flows)
	shift
	if [ $(($# % 2)) -ne 0 ] || [ $# -gt 64 ]; then
		refuse "usage: flows [ENDPOINT CLASS]... (at most 32)"
	fi
	i=1
	for w in "$@"; do
		if [ $((i % 2)) -eq 1 ]; then
			{ [ -n "$w" ] && only_chars "$w" '0-9a-fA-F.:/\133\135'; } ||
				refuse "flows: $w: ADDR[/LEN][:PORT], [IPv6][/LEN][:PORT] or :PORT"
			[ ${#w} -le 64 ] || refuse "flows: $w: too long"
		else
			case $w in auto | ordered | deadline | reorder | direct | reliable) ;; *) refuse "flows: $w: auto, ordered, deadline, reorder, direct or reliable" ;; esac
		fi
		i=$((i + 1))
	done
	set_flows "$@"
	;;
*)
	refuse "not allowed: ${SSH_ORIGINAL_COMMAND:-a shell} (get, mode, fec, protocontroller, set, unset, flows)"
	;;
esac
