# What the routers forward: the cengarde server writes its forward table (IP
# pass and each router's own rules) to /var/lib/cengarde/forward, or, with
# one router and the global key, what it asks for, on or off, to
# /var/lib/cengarde/passthrough (both kept across reboots). This unit then
# runs cengarde-passthrough.service, which applies it with
# "cengarde-nat sync".
[Unit]
Description=cengarde: watch what the routers forward

[Path]
PathChanged=/var/lib/cengarde/forward
PathChanged=/var/lib/cengarde/passthrough

[Install]
WantedBy=multi-user.target
