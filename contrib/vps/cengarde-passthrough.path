# IP pass from the router (protocol 3): the cengarde server writes what the
# router asks for, on or off, to /var/lib/cengarde/passthrough (kept across
# reboots), and this unit then runs cengarde-passthrough.service, which
# applies it with "cengarde-nat sync".
[Unit]
Description=cengarde: watch the IP pass the router asks for

[Path]
PathChanged=/var/lib/cengarde/passthrough

[Install]
WantedBy=multi-user.target
