# Started by cengarde-passthrough.path: forwards TCP and UDP ports of this
# server to the routers (IP pass, and their own rules) as the engine's
# forward table says.
[Unit]
Description=cengarde: apply what the routers forward
After=cengarde-nat.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cengarde-nat sync
