*filter
:CG_IN - [0:0]
:CG_FWD - [0:0]
-A CG_IN -p udp --dport 65500 -j ACCEPT
-A CG_IN ! -i lo -p udp --dport 65501:65532 -j DROP
-A CG_FWD -i cg-+ -d 169.254.0.0/16 -j REJECT --reject-with icmp-net-prohibited
-A CG_FWD -o cg-+ -m conntrack --ctstate DNAT -j ACCEPT
-A CG_FWD -i cg-+ -o cg-+ -j DROP
-A CG_FWD -i cg-+ -j ACCEPT
-A CG_FWD -o cg-+ -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
COMMIT
*nat
:CG_PRE - [0:0]
:CG_POST - [0:0]
-A CG_PRE -d 10.79.0.1 -j RETURN
-A CG_PRE -p tcp --dport 1:79 -j RETURN
-A CG_PRE -p tcp --dport 81:442 -j RETURN
-A CG_PRE -p tcp --dport 444:1023 -j RETURN
-A CG_PRE -p tcp --dport 3000 -j RETURN
-A CG_PRE -p tcp --dport 8080 -j RETURN
-A CG_PRE -p tcp --dport 9443 -j RETURN
-A CG_PRE -p udp --dport 1:1023 -j RETURN
-A CG_PRE -p udp --dport 5000:5010 -j RETURN
-A CG_PRE -p udp --dport 5353 -j RETURN
-A CG_PRE -p udp --dport 27015:27020 -j RETURN
-A CG_PRE -p udp --dport 51820 -j RETURN
-A CG_PRE -p udp --dport 65500:65532 -j RETURN
-A CG_PRE -p tcp --dport 1024:65000 -j DNAT --to-destination 10.79.0.2
-A CG_PRE -p udp --dport 1024:65000 -j DNAT --to-destination 10.79.0.2
-A CG_POST -s 10.79.0.0/16 -o cg-+ -m conntrack --ctstate DNAT -j SNAT --to-source 10.79.0.1
-A CG_POST -s 10.79.0.0/16 ! -o cg-+ -j MASQUERADE
COMMIT
