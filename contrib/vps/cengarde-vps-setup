#!/bin/sh
# The routers of a cengarde server, one file each in /etc/cengarde/clients,
# and everything derived from them: the engine's configuration (its TUN cg0,
# 10.79.0.1/16, with each router's tunnel address routed to it by the
# engine) and the firewall (cengarde-nat). Every key derives from a router's
# pairing secret ("cengarde keys"), the only value both ends share; it is
# read from standard input, never from the command line. A server set up
# for WireGuard before 0.12 (a cg-NAME per router) loses it on the first
# run: the engine's TUN carries every router since (story 027).
#
#   cengarde-vps-setup               everything again from clients/; a 0.4
#                                    server migrated; on a server set up by
#                                    the cloud-config, /etc/cengarde/secret
#                                    imported, once, as the first router
#   cengarde-vps-setup add [NAME] [--label TEXT] [--tunnel-addr ADDR]
#                      [--replace] [--rename OLD] [--proto N] [--public-ip ADDR]
#                                    a router (default name: ROUTER_NAME), at
#                                    the tunnel address its secret gives
#                                    unless --tunnel-addr says otherwise (the
#                                    router's LuCI shows the command); run
#                                    again, it changes nothing
#   cengarde-vps-setup remove NAME
#   cengarde-vps-setup list          the routers and when they were last heard
#   cengarde-vps-setup forward       what is forwarded to whom, the ports this
#                                    server keeps (and why), and what to open
#                                    in front of a server behind NAT
#   cengarde-vps-setup forward add|del NAME PROTO:PORT[-PORT][=TO]...
#                                    a router's own rules: PROTO tcp, udp or
#                                    both, TO the port on the router; del
#                                    takes "all" too
#   cengarde-vps-setup forward off|on NAME
#   cengarde-vps-setup forward limit NAME N|default
#   cengarde-vps-setup forward allow|disallow PROTO:PORT[-PORT]...   (below 1024)
#   cengarde-vps-setup forward reserve|unreserve PROTO:PORT[-PORT]...
#   cengarde-vps-setup ipv6 on|off   the routers' IPv6 through the tunnels
#                                    (TUNNEL_IPV6): each router's ULA, derived
#                                    from its secret, ::1 here and ::2 on the
#                                    router, masqueraded out (cengarde-nat);
#                                    the router turns it on in LuCI too
#   cengarde-vps-setup protocontroller on|off
#                                    the protocontroller (PROTOCONTROLLER,
#                                    story 025): the routers that set it to
#                                    A or B in LuCI hand their TCP to this
#                                    engine, which opens a fresh TCP to each
#                                    destination (cubic, BBR once that leg
#                                    loses; tcp_bbr loaded at boot); the
#                                    engine restarts
#   cengarde-vps-setup fec on|rlc|off
#                                    the repair data (FEC, story 026): on,
#                                    the rings and decoders that rebuild
#                                    what the routers' parity and repairs
#                                    cover (fec, redund_spare, fec_code =
#                                    rlc in LuCI's Protection tab); rlc, the
#                                    same and FEC v3's repairs on the
#                                    download too (fec_pct and fec_window_ms
#                                    as the engine's, or in engine.local);
#                                    the engine restarts
#   cengarde-vps-setup refresh       the engine's configuration again, reloaded
#                                    if it changed (cengarde-nat check)
#   cengarde-vps-setup purge [--all] the services of install.sh removed and the
#                                    secret of the router in slot 0 written back
#                                    to /etc/cengarde/secret, so that cengarde
#                                    0.4's install.sh works again; --all also
#                                    removes the routers and the engine's state
#
# The engine (protocol 4, cengarde 0.5.2) serves up to 32 routers, each a
# [client NAME] section of its configuration, and each router runs 0.5.2
# too. A router's tunnel address derives from its secret, as on the router;
# one set up before 0.5.2 keeps 10.79.0.2, the address then. What a router
# gets of this server's ports: IP pass, PASSTHROUGH_PORTS (1024:65000) to the
# one router that asks for it first and keeps asking, and its own rules
# ("forward add", at most FORWARD_MAX_PORTS ports each, "forward limit"),
# which IP pass's range leaves to them; never a reserved port ("forward
# allow" frees one below 1024). The engine writes the outcome to its forward
# table, /var/lib/cengarde/forward, and cengarde-passthrough.path has
# cengarde-nat apply it. The tunnels are the engine's TUN, authenticated
# but not encrypted (story 014).
# Settings: /etc/cengarde/nat.conf (see cengarde-nat). The engine's own
# global settings by hand (governor, split_spread_ms...: see
# engine/examples/server.conf) go in /etc/cengarde/engine.local, one
# "key = value" per line, no [sections]: every run copies it into the
# configuration it writes, which is regenerated from scratch and so would
# lose an edit made there.
# CENGARDE_ROOT goes in front of every path (tests). CENGARDE_NO_RELOAD=1
# writes the configuration without asking the running engine to reload it
# (install.sh, which restarts the engine right after).
#
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

PATH=$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
R=${CENGARDE_ROOT:-}
ME=cengarde-vps-setup

CENGARDE_PORT=65500
SSH_PORT=22
PASSTHROUGH_PORTS=1024:65000
FORWARD_ALLOW_LOW=
FORWARD_RESERVED=
FORWARD_UNRESERVE=
FORWARD_MAX_PORTS=1024
TUNNEL_IPV6=no
PROTOCONTROLLER=no
FEC=no
ROUTER_NAME=router
# ROUTER_TUNNEL_ADDR, the cloud-config's router's tunnel address, is left
# unset: a cloud-config without it is older than 0.5.2, and its router has
# 10.79.0.2.
ENGINE_USER=cengarde

ETC=$R/etc/cengarde
CONF=${CENGARDE_NAT_CONF:-$ETC/nat.conf}
CLIENTS=$ETC/clients
SECRET_FILE=$ETC/secret
IDLE_KEY=$ETC/idle-key
ENGINE_CONF=$ETC/cengarde.conf
LOCAL_CONF=$ETC/engine.local
# Where WireGuard lived before 0.12: removed on the first run (drop_wireguard).
WG_DIR=$R/etc/wireguard
STATE_DIR=$R/var/lib/cengarde
PASS_FILE=$STATE_DIR/passthrough
FWD_FILE=$STATE_DIR/forward
OLD_PASS=$R/var/lib/cengarde-nat/passthrough
NAT_STATE=$R/run/cengarde-nat
SOCK=$R/run/cengarde/cengarde.sock
LOCK=$R/run/lock/cengarde-admin.lock
UNITS=$R/etc/systemd/system
SYSUSERS=$R/etc/sysusers.d/cengarde.conf
CTL_TIMEOUT=${CENGARDE_CTL_TIMEOUT:-15}
SERVER_ADDR=10.79.0.1
# The engine's TUN and its addresses (every router's tunnel address and ULA
# inside their prefixes).
TUN_DEV=cg0
TUN_NET=$SERVER_ADDR/16
TUN_NET6=fd79::1/8
# The drop-in that let the engine open /dev/net/tun before 0.12, when only
# TUNNEL=native needed it: cengarde.service allows it itself now.
NATIVE_DROPIN=$UNITS/cengarde.service.d/native.conf
LEGACY_TUNNEL=10.79.0.2 # every router set up before 0.5.2
MAX_ROUTERS=32          # slots 0 to 31

say() { echo "$ME: $*"; }
warn() { echo "$ME: $*" >&2; }
die() {
	warn "$*"
	exit 1
}

# safe FILE|DIR: owned by root, writable by nobody else, not a symlink.
safe() {
	local m
	[ -e "$1" ] && [ ! -L "$1" ] || return 1
	m=$(stat -c '%u %a' -- "$1" 2>/dev/null) || return 1
	[ "${m%% *}" = 0 ] && [ $((0${m#* } & 022)) -eq 0 ]
}
is_port() {
	case $1 in '' | *[!0-9]*) return 1 ;; esac
	[ ${#1} -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}
# A router's name: 1 to 12 characters, as the engine takes them.
is_name() {
	case $1 in '' | default | -* | *[!a-z0-9-]*) return 1 ;; esac
	[ ${#1} -le 12 ]
}
is_tunnel() {
	local IFS=. x
	# shellcheck disable=SC2086 # split on the dots
	set -- $1
	[ $# -eq 4 ] && [ "$1" = 10 ] && [ "$2" = 79 ] || return 1
	for x in "$3" "$4"; do
		case $x in '' | *[!0-9]*) return 1 ;; esac
		[ ${#x} -le 3 ] && [ "$x" -le 255 ] || return 1
	done
	[ $(($3 * 256 + $4)) -ge 2 ] && [ $(($3 * 256 + $4)) -le 65534 ]
}

if [ -e "$CONF" ]; then
	safe "$CONF" || die "$CONF must be a file owned by root and writable by nobody else"
	# shellcheck source=/dev/null
	. "$CONF"
fi
is_port "$CENGARDE_PORT" || die "CENGARDE_PORT in $CONF: not a port"
case $PROTOCONTROLLER in yes | no) ;; *) die "PROTOCONTROLLER in $CONF: yes or no" ;; esac
case $FEC in yes | rlc | no) ;; *) die "FEC in $CONF: yes, rlc or no" ;; esac
# What IP pass forwards (cengarde-nat refuses a bad one).
PASS_LO=${PASSTHROUGH_PORTS%%:*} PASS_HI=${PASSTHROUGH_PORTS#*:}
is_port "$PASS_LO" && is_port "$PASS_HI" || PASS_LO=1024 PASS_HI=65000
ENGINE_GROUP=$ENGINE_USER

TMPF=
STTY=
PUBLIC_IP=''
UNDO=
# shellcheck disable=SC2317 # run by the trap
cleanup() {
	local rc=$? f n=0
	if [ -n "$STTY" ]; then
		stty echo 2>/dev/null || :
		STTY=
	fi
	[ -z "$TMPF" ] || rm -f "$TMPF"
	if [ -n "$UNDO" ]; then
		if [ "$rc" -ne 0 ]; then
			while read -r f; do
				n=$((n + 1))
				if [ -e "$UNDO/$n" ]; then mv "$UNDO/$n" "$f"; else rm -f "$f"; fi
			done <"$UNDO/list"
			warn "nothing changed"
		fi
		rm -rf "$UNDO"
	fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# keep FILE...: put back as they are now if this command fails. Each copy
# is named by its line in the list, not by the file's name: a router may be
# called "passthrough", as the IP pass file is.
keep() {
	local f
	[ -n "$UNDO" ] || {
		UNDO=$ETC/.undo
		rm -rf "$UNDO"
		mkdir -m 0700 "$UNDO"
		: >"$UNDO/list"
	}
	for f in "$@"; do
		! grep -qxF "$f" "$UNDO/list" || continue
		echo "$f" >>"$UNDO/list"
		[ ! -e "$f" ] || cp -p "$f" "$UNDO/$(($(wc -l <"$UNDO/list")))"
	done
}
# kept: what keep saved is not needed any more.
kept() {
	rm -rf "$UNDO"
	UNDO=
}

lock() {
	[ "${CENGARDE_ADMIN_LOCKED:-}" = 1 ] && return 0
	mkdir -p "${LOCK%/*}"
	exec 9>"$LOCK"
	flock 9
	CENGARDE_ADMIN_LOCKED=1
	export CENGARDE_ADMIN_LOCKED
}

# ---- the routers ----

# kv FILE KEY: KEY's value in FILE (never sourced).
kv() { sed -n "s/^$2=//p" "$1" | tail -n 1; }

routers() {
	local f
	[ -d "$CLIENTS" ] || return 0
	for f in "$CLIENTS"/*; do
		[ -e "$f" ] || continue
		is_name "${f##*/}" && echo "${f##*/}"
	done
}
nrouters() { routers | wc -l; }

# load NAME: the router's settings into C_*; its file must be safe.
load() {
	local f="$CLIENTS/$1" t
	if ! safe "$f" || [ ! -f "$f" ]; then
		die "$f must be a file owned by root and writable by nobody else"
	fi
	C_NAME=$1
	C_SECRET=$(kv "$f" SECRET)
	C_SLOT=$(kv "$f" SLOT)
	C_ADDR=$(kv "$f" TUNNEL_ADDR)
	C_LABEL=$(kv "$f" LABEL)
	C_ADDED=$(kv "$f" ADDED)
	C_FORWARD=$(kv "$f" FORWARD)
	C_MAXP=$(kv "$f" FORWARD_MAX_PORTS)
	C_IMPORTED=$(kv "$f" IMPORTED)
	C_LEGACY=$(kv "$f" LEGACY_ADDR)
	C_RULES=$(kv "$f" RULES)
	[ "$C_FORWARD" = no ] || C_FORWARD=yes
	case $C_SLOT in '' | *[!0-9]*) die "$f: SLOT is not a number" ;; esac
	is_tunnel "$C_ADDR" || die "$f: TUNNEL_ADDR is not a router's tunnel address"
	for t in $C_RULES; do
		[ "$(rule "$t")" = "$t" ] || die "$f: RULES: $t is not a rule as cengarde-vps-setup writes it"
	done
}

# save: C_* to clients/C_NAME, whole, root-only.
save() {
	mkdir -p "$CLIENTS"
	chmod 0700 "$CLIENTS"
	TMPF=$CLIENTS/.$C_NAME.new
	(umask 077 && cat >"$TMPF") <<-EOF
		# Router $C_NAME of this cengarde server: its pairing secret, and what
		# the server keeps about it. Written by cengarde-vps-setup; change it
		# with cengarde-vps-setup, not by hand.
		SECRET=$C_SECRET
		SLOT=$C_SLOT
		TUNNEL_ADDR=$C_ADDR
		LABEL=$C_LABEL
		ADDED=$C_ADDED
		FORWARD=$C_FORWARD
		FORWARD_MAX_PORTS=$C_MAXP
		IMPORTED=$C_IMPORTED
		LEGACY_ADDR=$C_LEGACY
		RULES=$C_RULES
	EOF
	mv "$TMPF" "$CLIENTS/$C_NAME"
	TMPF=
}

# with_secret: the name of the router whose secret is SECRET, if any.
with_secret() {
	local n
	for n in $(routers); do
		[ "$(kv "$CLIENTS/$n" SECRET)" = "$SECRET" ] && echo "$n" && return 0
	done
	return 0
}

free_slot() {
	local s used n
	used=$(for n in $(routers); do kv "$CLIENTS/$n" SLOT; done)
	s=0
	while [ "$s" -lt 32 ]; do
		echo "$used" | grep -qx "$s" || {
			echo "$s"
			return 0
		}
		s=$((s + 1))
	done
	return 1
}

# keys: the keys derived from SECRET into CG_*; 1 when it is not a secret.
keys() {
	local out
	case $SECRET in *[!A-Za-z0-9+/=]*) return 1 ;; esac
	[ ${#SECRET} -eq 44 ] || return 1
	# printf is a shell builtin: the secret never shows in a command line.
	out=$(printf '%s\n' "$SECRET" | cengarde keys 2>/dev/null) || return 1
	eval "$out"
}

# read_secret NAME: SECRET from standard input; on a terminal, not echoed.
read_secret() {
	SECRET=
	if [ -t 0 ]; then
		printf 'Pairing secret of router %s (LuCI shows it in the VPS tab), not echoed: ' "$1" >&2
		STTY=1
		stty -echo
		IFS= read -r SECRET || :
		stty echo
		STTY=
		echo >&2
	else
		IFS= read -r SECRET || :
	fi
	SECRET=$(printf '%s' "$SECRET" | tr -d ' \t\r')
}

ask() { # QUESTION: yes on a terminal that says y
	local a
	[ -t 0 ] || return 1
	printf '%s [y/N] ' "$1" >&2
	IFS= read -r a || return 1
	case $a in y | Y | yes | si | sí | s) return 0 ;; esac
	return 1
}

engine_proto() { cengarde version 2>/dev/null | sed -n 's/.*(protocol \([0-9][0-9]*\)).*/\1/p'; }

# links: "cengarde ctl links" in LINKS, asked once per command ("-": the
# engine cannot be asked). Called before $(last_seen), whose subshell
# would ask again for every router.
LINKS=
links() {
	[ -z "$LINKS" ] || return 0
	LINKS=-
	[ -S "$SOCK" ] || return 0
	LINKS=$(timeout 5 cengarde ctl -s "$SOCK" links 2>/dev/null) || LINKS=-
}

# last_seen NAME: when the engine last heard router NAME. Its table has a
# CLIENT column when it serves routers by name; without it, every session
# is of the one router.
last_seen() {
	links
	if [ "$LINKS" = - ]; then
		echo "-"
		return 0
	fi
	echo "$LINKS" | awk -v name="$1" '
	NR == 1 { byname = $1 == "CLIENT"; next }
	byname && $1 != name { next }
	{
		id = byname ? $2 : $1
		for (i = 2; i < NF; i++) if ($i ~ /^[0-9]+\.[0-9]$/ && $(i + 1) == "s") { if (min == "" || $i + 0 < min + 0) min = $i; s[id] = 1 }
	}
	END { n = 0; for (k in s) n++; if (min == "") print "never (no session)"; else printf "%s s ago, %d session%s\n", min, n, (n == 1 ? "" : "s") }'
}

# ---- what gets written ----

ensure_dirs() {
	mkdir -p "$ETC"
	chgrp "$ENGINE_GROUP" "$ETC" 2>/dev/null || warn "no group $ENGINE_GROUP (systemd-sysusers, see install.sh)"
	chmod 0750 "$ETC"
	if [ -d "$CLIENTS" ]; then
		chown root "$CLIENTS" && chmod 0700 "$CLIENTS"
	fi
}

idle_key() {
	if [ ! -s "$IDLE_KEY" ]; then
		(umask 077 && cengarde genkey >"$IDLE_KEY") || die "cengarde genkey"
	fi
	cat "$IDLE_KEY"
}

# engine_conf: the engine's configuration, on stdout: a [client NAME]
# section per router, or, with none, a key that serves nobody. Going from
# none to one router, or back, restarts the engine; nobody is cut by it.
engine_conf() {
	local n reserved
	reserved=$(cengarde-nat reserved) || die "cengarde-nat reserved failed (see above)"
	reserved=$(echo "$reserved" | tr '\n' ' ' | sed 's/ $//')
	cat <<-EOF
		# Written by cengarde-vps-setup from $CLIENTS; run it again instead of
		# editing. Other settings: $LOCAL_CONF (engine/examples/server.conf).
		mode = server
		listen = *:$CENGARDE_PORT
		status_file = /run/cengarde/status.json
		# "cengarde ctl status" (or links), as root.
		control_socket = /run/cengarde/cengarde.sock
		# The ports a router can never have (cengarde-nat reserved): a rule
		# that takes one is refused by "cengarde-vps-setup forward add", and
		# skipped by cengarde-nat if the port is reserved later.
		# reserved: $reserved
		# Lower latency for more CPU (docs/historias/006); fine on dedicated vCPUs.
		#busy_poll_us = 50
		# The routers' IP packets through one TUN, authenticated but not
		# encrypted; each router's own addresses are its tun_route.
		tun = $TUN_DEV
		tun_addr = $TUN_NET$(! tunnel_v6 || echo " $TUN_NET6")
	EOF
	[ "$PROTOCONTROLLER" = yes ] && cat <<-EOF
		# The protocontroller (cengarde-vps-setup protocontroller off removes
		# it): the TCP the routers hand over, as a stream (b) or a TCP to this
		# end of the tunnel (a), opened here to its destination (story 025; a
		# server takes both variants with either).
		protocontroller = b
	EOF
	[ "$FEC" = no ] || cat <<-EOF
		# The repair data (cengarde-vps-setup fec off removes it): each
		# session keeps the DATA it got lately and rebuilds what the routers'
		# parity and repairs cover (story 026; ~5 MB a session).
		fec = yes
	EOF
	[ "$FEC" = rlc ] && cat <<-EOF
		# And FEC v3's repairs on the download (cengarde-vps-setup fec on
		# leaves them out): a share of the bytes over a sliding window, so a
		# router rebuilds what a path loses (~2 MB more a session).
		fec_code = rlc
	EOF
	if [ -s "$LOCAL_CONF" ]; then
		# Before the [client] sections, which would take its keys.
		! grep -q '^[[:space:]]*\[' "$LOCAL_CONF" || die "$LOCAL_CONF: the engine's global settings only, no [section]"
		echo "# By hand, from $LOCAL_CONF:"
		cat "$LOCAL_CONF"
	fi
	if [ "$(nrouters)" -eq 0 ]; then
		cat <<-EOF
			# No router yet ("cengarde-vps-setup add"): a key that serves nobody.
			key = $(idle_key)
		EOF
		return 0
	fi
	cat <<-EOF
		# What each router gets of this server's ports (IP pass, and its
		# rules); cengarde-passthrough.path has cengarde-nat apply it.
		forward_file = /var/lib/cengarde/forward
	EOF
	for n in $(routers); do
		load "$n"
		keys_of "$n"
		cat <<-EOF

			[client $n]
			# $CLIENTS/$n
			key = $CG_LINK_KEY
			# What the TUN hands this router, and what it may send from.
			tun_route = $C_ADDR/32$(! tunnel_v6 || echo " $CG_TUNNEL_ULA::2/128")
		EOF
		# The engine takes 63 characters (0.5.1 took 64 here).
		[ -z "$C_LABEL" ] || printf 'label = %.63s\n' "$C_LABEL"
		if [ "$C_FORWARD" = no ]; then
			echo "# Forwarding off (cengarde-vps-setup forward on $n)."
			echo "passthrough = no"
			[ -z "$C_RULES" ] || echo "#forward = $C_RULES"
		else
			[ -z "$C_RULES" ] || echo "forward = $C_RULES"
		fi
	done
}

keys_of() { # NAME: CG_* of a configured router
	SECRET=$(kv "$CLIENTS/$1" SECRET)
	keys || die "$CLIENTS/$1: SECRET is not a pairing secret"
}

# reload: the engine reads its configuration again; its answer in RELOAD.
# 1 on an error, or no answer within CTL_TIMEOUT seconds. An engine that
# is not running (or restarting) reads the file when it starts.
reload() {
	local ans rc
	# install.sh restarts the engine right after (CENGARDE_NO_RELOAD=1): the
	# one running may be older than this configuration (0.5.0 and before
	# refuse [client] sections without a global key), and the new one reads
	# it when it starts.
	if [ "${CENGARDE_NO_RELOAD:-}" = 1 ]; then
		RELOAD="left to the restart that follows"
		return 0
	fi
	if ! systemctl is-active -q cengarde 2>/dev/null; then
		RELOAD="cengarde is not running: it reads this configuration when it starts"
		return 0
	fi
	if [ ! -S "$SOCK" ]; then
		systemctl reload cengarde || {
			RELOAD="error: systemctl reload cengarde failed"
			return 1
		}
		RELOAD="reloaded (systemctl reload cengarde: no control socket to answer)"
		return 0
	fi
	ans=$(timeout "$CTL_TIMEOUT" cengarde ctl -s "$SOCK" reload 2>&1) && rc=0 || rc=$?
	if [ "$rc" -eq 0 ]; then
		RELOAD=$ans
		return 0
	fi
	if [ "$rc" -eq 124 ]; then
		RELOAD="error: the engine did not answer \"cengarde ctl reload\" within $CTL_TIMEOUT s"
	else
		RELOAD="error: ${ans#cengarde ctl: }"
	fi
	return 1
}

# write_conf: the engine's configuration, checked by the engine before it
# goes in place, then reloaded; the previous file back on any error.
write_conf() {
	local new="$ETC/.cengarde.conf.new" old="$ETC/.cengarde.conf.old" out had=0
	RELOAD=unchanged
	TMPF=$new
	(umask 027 && engine_conf >"$new") || die "cannot write $new"
	chgrp "$ENGINE_GROUP" "$new" 2>/dev/null || :
	chmod 0640 "$new"
	if [ -e "$ENGINE_CONF" ] && cmp -s "$new" "$ENGINE_CONF"; then
		# Ownership and mode as they should be, from 0.4's 0600 root.
		chgrp "$ENGINE_GROUP" "$ENGINE_CONF" 2>/dev/null || :
		chmod 0640 "$ENGINE_CONF"
		rm -f "$new"
		TMPF=
		drop_wireguard
		return 0
	fi
	out=$(cengarde -t -c "$new" 2>&1) || die "the engine refuses the new configuration, so the previous one stays: $out"
	! grep -q '^\[client ' "$ENGINE_CONF" 2>/dev/null || had=1
	rm -f "$old"
	[ ! -e "$ENGINE_CONF" ] || cp -p "$ENGINE_CONF" "$old"
	mv "$new" "$ENGINE_CONF"
	TMPF=
	if ! reload; then
		if [ -e "$old" ]; then
			mv "$old" "$ENGINE_CONF"
			die "$RELOAD; the previous $ENGINE_CONF is back"
		fi
		rm -f "$ENGINE_CONF"
		die "$RELOAD"
	fi
	rm -f "$old"
	case $RELOAD in
	"ok: "*)
		if [ "$had" = 1 ]; then
			warn "the engine restarted (${RELOAD#ok: }): every router saw a cut of about 1 s"
		else
			say "the engine restarted (${RELOAD#ok: }), with no router to cut"
		fi
		;;
	esac
	drop_wireguard
	return 0
}

# drop_wireguard: what this script set up for WireGuard before 0.12 (story
# 027), once the engine runs the configuration that does without it (a
# cg-NAME's route to its router's address would win over the TUN's): each
# router's cg-NAME (wg-quick@cg-NAME and the file this script wrote), the
# file of the ports WireGuard knew the routers by, the systemd drop-in of
# TUNNEL=native (cengarde.service allows /dev/net/tun itself now) and
# TUNNEL and WG_PORT_BASE in nat.conf. Nothing the first time it ran
# already.
drop_wireguard() {
	local f n
	for f in "$WG_DIR"/cg-*.conf; do
		[ -e "$f" ] || continue
		head -n 1 "$f" | grep -q '^# Written by cengarde-vps-setup' || continue
		n=${f##*/cg-}
		n=${n%.conf}
		systemctl disable --now "wg-quick@cg-$n" 2>/dev/null || :
		rm -f "$f" "$WG_DIR/.cg-$n.conf.new" "$WG_DIR/.cg-$n.strip"
		say "cg-$n: its WireGuard stopped and removed (the engine's TUN $TUN_DEV carries every router since 0.12)"
	done
	if [ -e "$STATE_DIR/wg" ]; then
		rm -rf "$STATE_DIR/wg"
		say "$STATE_DIR/wg removed (WireGuard's ports, before 0.12)"
	fi
	if [ -e "$NATIVE_DROPIN" ]; then
		rm -f "$NATIVE_DROPIN"
		rmdir "${NATIVE_DROPIN%/*}" 2>/dev/null || :
		systemctl daemon-reload 2>/dev/null || warn "systemctl daemon-reload failed"
	fi
	if grep -Eq '^(TUNNEL|WG_PORT_BASE)=' "$CONF" 2>/dev/null; then
		unset_conf TUNNEL
		unset_conf WG_PORT_BASE
		say "TUNNEL and WG_PORT_BASE removed from $CONF: the engine's TUN is the only tunnel since 0.12"
	fi
}

# have_v6: this box has IPv6.
have_v6() { [ -e "$R/proc/net/if_inet6" ]; }
# tunnel_v6: the routers' IPv6 goes through the tunnels.
tunnel_v6() { [ "$TUNNEL_IPV6" = yes ] && have_v6; }

nat_apply() {
	cengarde-nat apply || die "cengarde-nat apply failed (see above)"
}

# ---- the main IPv4, and a server behind NAT ----

# main_ipv4: "ADDR DEV" of the default route, if any.
main_ipv4() {
	ip -4 route get 192.0.2.1 2>/dev/null |
		awk '{ for (i = 1; i < NF; i++) { if ($i == "src") a = $(i + 1); if ($i == "dev") d = $(i + 1) } } END { if (a != "") print a, d }'
}
private4() {
	case $1 in
	10.* | 192.168.*) return 0 ;;
	172.*)
		local b="${1#172.}"
		b=${b%%.*}
		[ "$b" -ge 16 ] && [ "$b" -le 31 ]
		;;
	*) return 1 ;;
	esac
}
cgnat4() {
	case $1 in
	100.*)
		local b="${1#100.}"
		b=${b%%.*}
		[ "$b" -ge 64 ] && [ "$b" -le 127 ]
		;;
	*) return 1 ;;
	esac
}

# set_conf VAR VALUE: VAR="VALUE" in nat.conf, in place or added.
set_conf() {
	TMPF=$CONF.new
	{ [ -e "$CONF" ] && cat "$CONF"; } | awk -v var="$1" -v val="$2" '
	index($0, var "=") == 1 { if (!done) print var "=\"" val "\""; done = 1; next }
	{ print }
	END { if (!done) print var "=\"" val "\"" }' >"$TMPF"
	chmod 0644 "$TMPF"
	mv "$TMPF" "$CONF"
	TMPF=
	eval "$1=\$2"
}

# unset_conf VAR: VAR's lines out of nat.conf, if any.
unset_conf() {
	grep -q "^$1=" "$CONF" 2>/dev/null || return 0
	TMPF=$CONF.new
	grep -v "^$1=" "$CONF" >"$TMPF" || :
	chmod 0644 "$TMPF"
	mv "$TMPF" "$CONF"
	TMPF=
}

# behind_nat: on a server whose main IPv4 is private (a home router, or a
# cloud with 1:1 NAT), FORWARD_SKIP_SRC once, and what to open in front.
behind_nat() {
	local m a d nets
	m=$(main_ipv4)
	[ -n "$m" ] || return 0
	a=${m% *} d=${m#* }
	if cgnat4 "$a"; then
		warn "this server's main IPv4, $a, is in 100.64.0.0/10: it is probably behind carrier-grade NAT, and routers cannot reach it as a server; it needs a public IPv4"
		return 0
	fi
	private4 "$a" || return 0
	if ! grep -q '^FORWARD_SKIP_SRC=' "$CONF" 2>/dev/null; then
		nets=$(ip -4 route show dev "$d" scope link proto kernel 2>/dev/null | awk '{ print $1 }' | tr '\n' ' ' | sed 's/ $//')
		if [ -n "$nets" ]; then
			set_conf FORWARD_SKIP_SRC "$nets"
			say "sources in $nets (this server's own network) are never forwarded to a router: FORWARD_SKIP_SRC in $CONF"
		fi
	fi
	say "this server's main IPv4, $a on $d, is private: it is behind a home router or a cloud with 1:1 NAT (Oracle Cloud, AWS, GCP)."
	say "open UDP $CENGARDE_PORT, and the ports \"cengarde-vps-setup forward\" lists, towards $a in your home router or in the provider's firewall (security list)${PUBLIC_IP:+; routers reach it at $PUBLIC_IP}"
}

# ---- the commands ----

# is_04_wg0: wg0.conf is cengarde 0.4's.
is_04_wg0() {
	[ -e "$WG_DIR/wg0.conf" ] && head -n 1 "$WG_DIR/wg0.conf" | grep -q '^# Written by cengarde-vps-setup'
}

# stop_04_wg0: cengarde 0.4's wg0 stopped, before the admin lock is taken:
# systemd, not this script, runs its PostDown ("cengarde-nat down wg0"),
# which takes the lock itself and would wait for this script until
# TimeoutStopSec.
stop_04_wg0() {
	! is_04_wg0 || systemctl disable --now wg-quick@wg0 2>/dev/null || :
}

# migrate_04: cengarde 0.4's single wg0 (stopped by stop_04_wg0) and its IP
# pass state, which the router tells the engine again once it runs 0.5.2.
migrate_04() {
	if is_04_wg0; then
		rm -f "$WG_DIR/wg0.conf"
		say "cengarde 0.4's wg0 stopped and removed: the engine's TUN $TUN_DEV carries its router now"
	fi
	if [ -e "$OLD_PASS" ]; then
		rm -f "$OLD_PASS"
		rmdir "${OLD_PASS%/*}" 2>/dev/null || :
		say "cengarde 0.4's IP pass state removed: the router asks for IP pass again once it runs cengarde 0.5.2"
	fi
}

check_proto() {
	P=$(engine_proto)
	# Protocol 5 only adds the previous link to DATA's flags, 6 CG_F_FREE,
	# 7 the FEC parity, 8 the erasure codes' repairs, 9 the parity requests
	# (PARQ) and the hint sealed after the copies, 10 the protocontroller's
	# streams (story 025; protocontroller is the engine's own knob), 11 FEC
	# v3's wide windows (story 026; fec_code is the engine's own knob) and
	# the active mask in the probes (story 013, reorder_active, on by
	# default): the same configurations.
	case "$P" in
	4 | 5 | 6 | 7 | 8 | 9 | 10 | 11) ;;
	*) die "this cengarde-vps-setup writes configurations of protocol 4 to 11 (cengarde 0.5.2 on, a [client NAME] section per router), and the engine says protocol ${P:-unknown}: install both from one checkout (contrib/vps/install.sh)" ;;
	esac
}

# import: /etc/cengarde/secret (cloud-config) as the first router, only
# into an empty clients/, and deleted once imported: a router removed
# later must not come back with the next install.sh. Its name and tunnel
# address are ROUTER_NAME and ROUTER_TUNNEL_ADDR, which the router's LuCI
# writes into the cloud-config; an older cloud-config has no address, and
# its router 10.79.0.2.
import() {
	local s other
	[ -e "$SECRET_FILE" ] || return 0
	SECRET=$(head -n 1 "$SECRET_FILE" | tr -d ' \t\r')
	if [ "$(nrouters)" -gt 0 ]; then
		other=$(with_secret)
		if [ -n "$other" ]; then
			rm -f "$SECRET_FILE"
			say "$SECRET_FILE is router $other's secret, already configured: removed"
		else
			warn "ignoring $SECRET_FILE: routers are configured; use \"cengarde-vps-setup add\""
		fi
		return 0
	fi
	keys || die "$SECRET_FILE is not a pairing secret (LuCI shows it in the VPS tab)"
	# REPLACE_*: the cloud-config of the repository, not filled in.
	if ! is_name "$ROUTER_NAME"; then
		case $ROUTER_NAME in REPLACE_*) ;; *) warn "ROUTER_NAME in $CONF is not a router name: \"router\" instead" ;; esac
		ROUTER_NAME=router
	fi
	s=$(free_slot)
	C_NAME=$ROUTER_NAME C_SECRET=$SECRET C_SLOT=$s C_ADDR=$LEGACY_TUNNEL C_LABEL='' C_RULES=''
	C_ADDED=$(date -u +%Y-%m-%dT%H:%M:%SZ) C_FORWARD=yes C_MAXP='' C_IMPORTED=1 C_LEGACY=1
	if [ -n "${ROUTER_TUNNEL_ADDR+set}" ]; then
		C_LEGACY=''
		if is_tunnel "$ROUTER_TUNNEL_ADDR" && [ "$ROUTER_TUNNEL_ADDR" != "$SERVER_ADDR" ]; then
			C_ADDR=$ROUTER_TUNNEL_ADDR
		else
			C_ADDR=$CG_TUNNEL_ADDR
			case $ROUTER_TUNNEL_ADDR in
			REPLACE_*) ;;
			*) warn "ROUTER_TUNNEL_ADDR in $CONF is not a router's tunnel address: the one of its secret instead, $C_ADDR" ;;
			esac
		fi
	fi
	save
	rm -f "$SECRET_FILE"
	say "router $C_NAME imported from $SECRET_FILE (then removed), tunnel address $C_ADDR"
}

# regen: everything from clients/.
regen() {
	ensure_dirs
	write_conf
	[ "$RELOAD" = unchanged ] || say "engine: $RELOAD"
	nat_apply
}

cmd_default() {
	check_proto
	stop_04_wg0
	lock
	migrate_04
	import
	behind_nat
	regen
	low_pass
	if [ "$(nrouters)" -eq 0 ]; then
		say "no router yet. On the router, LuCI's VPS tab shows the command to run here,"
		say "  sudo cengarde-vps-setup add NAME --tunnel-addr ADDR     (then paste its secret)"
	fi
}

cmd_add() {
	local name='' label='' label_set='' addr='' replace='' rename='' proto='' other old='' s
	PUBLIC_IP=''
	while [ $# -gt 0 ]; do
		case $1 in
		--label)
			[ $# -ge 2 ] || die "--label needs a text"
			label=$2 label_set=1
			shift
			;;
		--tunnel-addr)
			[ $# -ge 2 ] || die "--tunnel-addr needs an address"
			addr=$2
			shift
			;;
		--replace) replace=1 ;;
		--rename)
			[ $# -ge 2 ] || die "--rename needs the old name"
			rename=$2
			shift
			;;
		--proto)
			[ $# -ge 2 ] || die "--proto needs a number"
			proto=$2
			shift
			;;
		--public-ip)
			[ $# -ge 2 ] || die "--public-ip needs an address"
			PUBLIC_IP=$2
			shift
			;;
		-*) die "add: unknown option $1" ;;
		*)
			[ -z "$name" ] || die "add: one name only"
			name=$1
			;;
		esac
		shift
	done
	name=${name:-$ROUTER_NAME}
	is_name "$name" || die "$name: a router's name is 1 to 12 of a-z, 0-9 and -, not starting with -, and not \"default\""
	case $label in *[![:print:]]* | *'"'* | *\\*) die "--label: printable characters only, no quotes" ;; esac
	[ ${#label} -le 63 ] || die "--label: 63 characters at most"
	[ -z "$addr" ] || is_tunnel "$addr" || die "--tunnel-addr $addr: expected 10.79.X.Y, from 10.79.0.2 to 10.79.255.254"
	[ -z "$replace" ] || [ -z "$rename" ] || die "--replace and --rename do not go together"
	[ -z "$rename" ] || is_name "$rename" || die "--rename $rename: not a router name"
	P=$(engine_proto)
	if [ -n "$proto" ] && [ "$proto" != "$P" ]; then
		die "the router speaks protocol $proto, and this server's engine ($(cengarde version 2>/dev/null)) protocol ${P:-unknown}. Upgrade the server to the router's commit (LuCI shows it) first:
  git -C /opt/cengarde fetch --depth 1 https://github.com/KevinashoUWU/cengarde COMMIT
  git -C /opt/cengarde checkout FETCH_HEAD && sudo sh /opt/cengarde/contrib/vps/install.sh"
	fi
	check_proto
	read_secret "$name"
	keys || die "that is not a pairing secret (the router's LuCI shows it in the VPS tab, 44 characters)"
	lock
	ensure_dirs
	other=$(with_secret)
	if [ -e "$CLIENTS/$name" ]; then
		load "$name"
		if [ "$C_SECRET" != "$SECRET" ]; then
			[ -z "$other" ] || die "that secret is router $other's already"
			if [ -z "$replace" ] &&
				! ask "Router $name exists (tunnel $C_ADDR, last heard $(last_seen "$name")) with another secret. Replace it?"; then
				die "router $name exists with another secret: \"add $name --replace\" replaces it"
			fi
			say "replacing router $name: new secret"
			C_SECRET=$SECRET C_IMPORTED='' C_ADDED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
			# Its address as the new secret gives it, as on the router.
			[ -n "$addr" ] || [ -n "$C_LEGACY" ] || C_ADDR=$CG_TUNNEL_ADDR
		fi
	elif [ -n "$other" ]; then
		if [ "$rename" != "$other" ] && ! ask "That secret is router $other's. Rename $other to $name?"; then
			die "that secret is router $other's: \"add $name --rename $other\" renames it"
		fi
		load "$other"
		old=$other
		C_NAME=$name
		keep "$CLIENTS/$old" "$CLIENTS/$name"
		mv "$CLIENTS/$old" "$CLIENTS/$name"
	else
		[ -z "$rename" ] || die "--rename $rename: no router with that secret"
		if [ "$(nrouters)" -ge "$MAX_ROUTERS" ]; then
			die "this server has $MAX_ROUTERS routers already, the most this script serves"
		fi
		s=$(free_slot) || die "no slot left"
		C_NAME=$name C_SECRET=$SECRET C_SLOT=$s C_ADDR=$CG_TUNNEL_ADDR C_LABEL='' C_FORWARD=yes C_MAXP=''
		C_ADDED=$(date -u +%Y-%m-%dT%H:%M:%SZ) C_IMPORTED='' C_LEGACY='' C_RULES=''
	fi
	if [ -n "$addr" ]; then
		C_ADDR=$addr C_LEGACY=''
	fi
	[ -z "$label_set" ] || C_LABEL=$label
	[ "$C_ADDR" != "$SERVER_ADDR" ] || die "$C_ADDR is the server's own tunnel address"
	for other in $(routers); do
		[ "$other" != "$C_NAME" ] || continue
		[ "$(kv "$CLIENTS/$other" TUNNEL_ADDR)" != "$C_ADDR" ] ||
			die "router $other has the tunnel address $C_ADDR: generate a new secret on the router, or give another with --tunnel-addr"
	done
	keep "$CLIENTS/$C_NAME"
	save
	# The engine first: when it refuses the configuration, nothing changed.
	write_conf
	kept
	[ -z "$old" ] || say "router $old renamed to $C_NAME"
	behind_nat
	nat_apply
	say "router $C_NAME: tunnel address $C_ADDR (the router's LuCI shows the same, VPS tab), through the engine's TUN $TUN_DEV"
	say "this server: $(ip -o addr show scope global 2>/dev/null | awk '{ sub(/\/.*/, "", $4); printf "%s ", $4 }')port $CENGARDE_PORT"
	say "engine: $RELOAD"
}

cmd_remove() {
	local name="${1:-}" had
	[ -n "$name" ] || die "usage: remove NAME"
	is_name "$name" || die "$name: not a router name"
	check_proto
	lock
	[ -e "$CLIENTS/$name" ] || die "no router $name"
	load "$name"
	had=$(awk -v a="$C_ADDR" '$1 == "dnat" && $5 == a { print $2 " " ($3 == $4 ? $3 : $3 "-" $4) }' \
		"$NAT_STATE/applied" 2>/dev/null | tr '\n' ',' | sed 's/,$//; s/,/, /g')
	keep "$CLIENTS/$name"
	rm -f "$CLIENTS/$name"
	write_conf
	kept
	[ "$C_IMPORTED" != 1 ] || rm -f "$SECRET_FILE"
	nat_apply
	say "router $name removed${had:+; released its forwarding: $had}"
	say "engine: $RELOAD"
}

cmd_list() {
	local n
	links
	say "engine: $(cengarde version 2>/dev/null || echo 'not installed')"
	printf '%-12s %-4s %-14s %-8s %-28s %s\n' NAME SLOT TUNNEL FORWARD "LAST HEARD" LABEL
	for n in $(routers); do
		load "$n"
		printf '%-12s %-4s %-14s %-8s %-28s %s\n' "$n" "$C_SLOT" "$C_ADDR" \
			"$C_FORWARD" "$(last_seen "$n")" "$C_LABEL"
	done
	[ "$(nrouters)" -gt 0 ] || say "no router (cengarde-vps-setup add NAME)"
	[ ! -e "$NAT_STATE/applied" ] || say "IP pass: $(pass_view)"
	say "tunnels: the engine's TUN $TUN_DEV, authenticated but not encrypted"
	if tunnel_v6; then
		say "IPv6 through the tunnels: on (cengarde-vps-setup ipv6 off)"
	elif [ "$TUNNEL_IPV6" = yes ]; then
		say "IPv6 through the tunnels: TUNNEL_IPV6=yes, but this server has no IPv6"
	else
		say "IPv6 through the tunnels: off (cengarde-vps-setup ipv6 on)"
	fi
}

# pass_view: who has IP pass's range, as cengarde-nat applied it.
pass_view() {
	awk -v lo="$PASS_LO" -v hi="$PASS_HI" '
	$1 == "dnat" && $3 == lo && $4 == hi && $6 == lo { print "on, to " $7 " (" $5 ")"; f = 1; exit }
	END { if (!f) print "off" }' "$NAT_STATE/applied"
}

# allow_note TOKEN: what "forward allow" does for TOKEN: a router's own
# rule may take it; IP pass forwards only PASSTHROUGH_PORTS.
allow_note() {
	local lo="${1#*:}" hi
	hi=${lo#*-} lo=${lo%-*}
	if [ "$hi" -lt "$PASS_LO" ] || [ "$lo" -gt "$PASS_HI" ]; then
		say "$1 is allowed: a router gets it with \"cengarde-vps-setup forward add NAME $1\" (IP pass forwards only PASSTHROUGH_PORTS, $PASSTHROUGH_PORTS)"
	elif [ "$lo" -lt "$PASS_LO" ] || [ "$hi" -gt "$PASS_HI" ]; then
		say "$1 is allowed: IP pass forwards only its ports inside PASSTHROUGH_PORTS ($PASSTHROUGH_PORTS); a router gets all of it with \"cengarde-vps-setup forward add NAME $1\""
	else
		say "$1 is allowed, inside PASSTHROUGH_PORTS ($PASSTHROUGH_PORTS): IP pass forwards it to its router, unless this server uses it (cengarde-vps-setup forward says) or a router's own rule takes it"
	fi
}

# low_pass: a PASSTHROUGH_PORTS that starts below 1024, as cengarde 0.4 took
# it: those ports are reserved now, unless in FORWARD_ALLOW_LOW.
low_pass() {
	[ "$PASS_LO" -lt 1024 ] || return 0
	warn "PASSTHROUGH_PORTS ($PASSTHROUGH_PORTS) starts below 1024: cengarde 0.4 forwarded ports $PASS_LO-1023 too; now IP pass forwards only those in FORWARD_ALLOW_LOW (\"$FORWARD_ALLOW_LOW\"): cengarde-vps-setup forward allow tcp:PORT udp:PORT..."
}

# tokens CMD TOKEN...: checks PROTO:PORT[-PORT] tokens.
tokens() {
	local t lo hi
	[ $# -gt 1 ] || die "forward $1: give PROTO:PORT[-PORT], such as tcp:443"
	shift
	for t in "$@"; do
		echo "$t" | grep -Eqx '(tcp|udp):[0-9]{1,5}(-[0-9]{1,5})?' || die "$t: expected tcp|udp:PORT[-PORT]"
		lo=${t#*:} hi=${lo#*-} lo=${lo%-*}
		if ! is_port "$lo" || ! is_port "$hi" || [ "$lo" -gt "$hi" ]; then
			die "$t: ports 1 to 65535, first to last"
		fi
	done
}
# in_list LIST TOKEN, add_list LIST TOKEN, del_list LIST TOKEN
in_list() { echo " $1 " | grep -q " $2 "; }
add_list() { if in_list "$1" "$2"; then echo "$1"; else echo "${1:+$1 }$2"; fi; }
del_list() { echo " $1 " | sed "s| $2 | |g; s|^ *||; s| *$||"; }

# always_reserved TOKEN: SSH or cengarde.
always_reserved() {
	local p="${1%%:*}" lo="${1#*:}" hi
	hi=${lo#*-} lo=${lo%-*}
	[ "$p" = tcp ] && [ "$lo" -le "$SSH_PORT" ] && [ "$hi" -ge "$SSH_PORT" ] && return 0
	[ "$p" = udp ] && [ "$lo" -le "$CENGARDE_PORT" ] && [ "$hi" -ge "$CENGARDE_PORT" ] && return 0
	return 1
}

# rule TOKEN: a router's rule as the engine reads it, PROTO:PORT[-PORT][=TO]
# with PROTO tcp, udp or both and TO the port FIRST goes to on the router,
# in one spelling (no leading zeros, no range of one port, no "=TO" that
# says FIRST); 1 when it is not one.
rule() {
	echo "$1" | grep -Eqx '(tcp|udp|both):[0-9]{1,5}(-[0-9]{1,5})?(=[0-9]{1,5})?' || return 1
	echo "$1" | awk -F: '{
		r = $2; to = ""
		if (split(r, a, "=") == 2) { r = a[1]; to = a[2] }
		n = split(r, b, "-"); lo = b[1] + 0; hi = (n == 2 ? b[2] : b[1]) + 0
		to = (to == "" ? lo : to + 0)
		if (lo < 1 || hi > 65535 || lo > hi || to < 1 || to + hi - lo > 65535) exit 1
		printf "%s:%d%s%s\n", $1, lo, (hi != lo ? "-" hi : ""), (to != lo ? "=" to : "")
	}'
}

# rule_ports RULE...: how many ports they take ("both" counts twice).
rule_ports() {
	echo "$*" | tr ' ' '\n' | awk -F'[:=]' 'NF { n = split($2, b, "-"); p = (n == 2 ? b[2] - b[1] + 1 : 1); t += ($1 == "both" ? 2 : 1) * p } END { print t + 0 }'
}

# rules_check NAME RULE...: dies, saying why, when a rule router NAME
# (loaded) is to add takes a reserved port, overlaps one of its own rules or
# another router's, or takes it past its limit; or the server past the
# engine's 1024 rules.
rules_check() {
	local n="$1" o why res
	shift
	res=$(cengarde-nat reserved -v) || die "cengarde-nat reserved failed (see above)"
	why=$({
		echo "$res" | sed 's/^/reserved /'
		for o in $(routers); do
			[ "$o" = "$n" ] || echo "have $o $(kv "$CLIENTS/$o" RULES)"
		done
		echo "have $n $C_RULES"
		echo "new $n $*"
	} | awk -v max="${C_MAXP:-$FORWARD_MAX_PORTS}" -v me="$n" '
	function parse(t,   a, r, b, k) {
		split(t, a, ":"); r = a[2]; sub(/=.*/, "", r)
		k = split(r, b, "-"); LO = b[1] + 0; HI = (k == 2 ? b[2] : b[1]) + 0
		NP = 0
		if (a[1] == "both" || a[1] == "tcp") P[++NP] = "tcp"
		if (a[1] == "both" || a[1] == "udp") P[++NP] = "udp"
	}
	function hit(p, lo, hi, q, qlo, qhi) { return p == q && lo <= qhi && hi >= qlo }
	function span(lo, hi) { return lo == hi ? lo : lo "-" hi }
	function reason(w, t) {
		if (w == "below-1024") return "below 1024 (cengarde-vps-setup forward allow " t " frees it)"
		if (w == "ssh") return "SSH"
		if (w == "docker") return "published by Docker"
		if (w == "FORWARD_RESERVED") return "FORWARD_RESERVED in nat.conf"
		if (w ~ /^listener/) { sub(/^listener:?/, "", w); return "something listening here" (w != "" ? ": " w : "") }
		return w
	}
	$1 == "reserved" { parse($2); for (i = 1; i <= NP; i++) { nr++; rp[nr] = P[i]; rlo[nr] = LO; rhi[nr] = HI; rw[nr] = $3 } next }
	$1 == "have" {
		for (k = 3; k <= NF; k++) {
			parse($k)
			for (i = 1; i <= NP; i++) {
				nh++; hp[nh] = P[i]; hlo[nh] = LO; hhi[nh] = HI; hn[nh] = $2; ht[nh] = $k
				if ($2 == me) used += HI - LO + 1
			}
		}
		next
	}
	$1 == "new" {
		for (k = 3; k <= NF; k++) {
			parse($k)
			for (i = 1; i <= NP; i++) {
				for (j = 1; j <= nr; j++)
					if (hit(P[i], LO, HI, rp[j], rlo[j], rhi[j])) {
						print $k ": " rp[j] " " span(rlo[j], rhi[j]) " is reserved on this server, " reason(rw[j], $k)
						exit
					}
				for (j = 1; j <= nh; j++)
					if (hit(P[i], LO, HI, hp[j], hlo[j], hhi[j])) {
						print $k ": overlaps " ht[j] ", a rule of " (hn[j] == me ? "this router" : "router " hn[j])
						exit
					}
				nh++; hp[nh] = P[i]; hlo[nh] = LO; hhi[nh] = HI; hn[nh] = me; ht[nh] = $k
				used += HI - LO + 1
			}
		}
		if (used > max)
			print "router " me " would forward " used " ports with its own rules, past its limit of " max " (cengarde-vps-setup forward limit " me " N)"
		else if (nh > 1024)
			print "the routers would have " nh " rules (a \"both\" counts twice), past the engine'"'"'s 1024"
	}')
	[ -z "$why" ] || die "$why"
}

cmd_forward() {
	local sub="${1:-}" t v n r new
	case $sub in
	'')
		cengarde-nat status 2>&1 | grep -v '^cengarde-nat: reserved: '
		echo "Reserved on this server, never forwarded nor given to a router:"
		cengarde-nat reserved -v | awk '{ w = $2
			sub(/^listener:/, "something listening here: ", w)
			if (w == "listener") w = "something listening here"
			if (w == "below-1024") w = "below 1024 (forward allow frees one, for a rule of a router)"
			if (w == "ssh") w = "SSH"
			if (w == "docker") w = "published by Docker"
			if (w == "FORWARD_RESERVED") w = "FORWARD_RESERVED in nat.conf"
			printf "  %-18s %s\n", $1, w }'
		low_pass
		echo "Forwarding per router (cengarde-vps-setup forward off|on NAME, forward add|del NAME RULE...):"
		links
		for n in $(routers); do
			load "$n"
			echo "  $n: $C_FORWARD, last heard $(last_seen "$n")"
			[ -z "$C_RULES" ] ||
				echo "    its rules: $C_RULES ($(rule_ports "$C_RULES") of ${C_MAXP:-$FORWARD_MAX_PORTS} ports)"
		done
		[ ! -e "$NAT_STATE/applied" ] || echo "IP pass ($PASSTHROUGH_PORTS): $(pass_view)"
		behind_nat_view
		;;
	off | on)
		[ $# -eq 2 ] || die "usage: forward $sub NAME"
		check_proto
		lock
		if ! is_name "$2" || [ ! -e "$CLIENTS/$2" ]; then
			die "no router $2"
		fi
		load "$2"
		if [ "$sub" = on ]; then C_FORWARD=yes; else C_FORWARD=no; fi
		keep "$CLIENTS/$2"
		save
		write_conf
		kept
		nat_apply
		say "forwarding to router $2: $C_FORWARD"
		;;
	limit)
		[ $# -eq 3 ] || die "usage: forward limit NAME N|default"
		lock
		if ! is_name "$2" || [ ! -e "$CLIENTS/$2" ]; then
			die "no router $2"
		fi
		load "$2"
		case $3 in
		default) C_MAXP='' ;;
		*)
			case $3 in '' | *[!0-9]*) die "forward limit: N is a number of ports, or default" ;; esac
			[ "$3" -le 131070 ] || die "forward limit: at most 131070 (every port, TCP and UDP)"
			C_MAXP=$3
			;;
		esac
		v=$(rule_ports "$C_RULES")
		[ "$v" -le "${C_MAXP:-$FORWARD_MAX_PORTS}" ] ||
			die "router $2's rules take $v ports already: remove some first (cengarde-vps-setup forward del $2 RULE...)"
		keep "$CLIENTS/$2"
		save
		kept
		say "router $2 may forward ${C_MAXP:-$FORWARD_MAX_PORTS} ports with its own rules${C_MAXP:+ (FORWARD_MAX_PORTS: $FORWARD_MAX_PORTS)}; it has $v"
		;;
	add | del)
		[ $# -ge 3 ] || die "usage: forward $sub NAME PROTO:PORT[-PORT][=TO]...$([ "$sub" = add ] || echo '|all')"
		n=$2
		shift 2
		check_proto
		lock
		if ! is_name "$n" || [ ! -e "$CLIENTS/$n" ]; then
			die "no router $n"
		fi
		load "$n"
		v=$C_RULES
		new=
		for t in "$@"; do
			if [ "$sub" = del ] && [ "$t" = all ]; then
				v=
				continue
			fi
			r=$(rule "$t") ||
				die "$t: expected PROTO:PORT[-PORT][=TO], PROTO tcp, udp or both, ports 1 to 65535 (such as tcp:8080=80, udp:5000-5010, both:25565)"
			if [ "$sub" = add ]; then
				in_list "$v" "$r" && continue
				new="${new:+$new }$r"
				v=$(add_list "$v" "$r")
			else
				in_list "$v" "$r" || die "$t: router $n has no such rule (its rules: ${C_RULES:-none})"
				v=$(del_list "$v" "$r")
			fi
		done
		[ -z "$new" ] || rules_check "$n" "$new"
		if [ "$v" = "$C_RULES" ]; then
			say "router $n's rules unchanged: ${C_RULES:-none}"
			return 0
		fi
		C_RULES=$v
		keep "$CLIENTS/$n"
		save
		write_conf
		kept
		nat_apply
		say "router $n's rules: ${C_RULES:-none}"
		[ "$C_FORWARD" = yes ] || say "forwarding to router $n is off: its rules wait (cengarde-vps-setup forward on $n)"
		;;
	allow | disallow)
		tokens "$@"
		shift
		check_proto
		lock
		v=$FORWARD_ALLOW_LOW
		for t in "$@"; do
			case ${t#*:} in *-*) n=${t##*-} ;; *) n=${t#*:} ;; esac
			[ "$n" -le 1023 ] ||
				die "$t: forward $sub is for ports below 1024; the others, inside PASSTHROUGH_PORTS ($PASSTHROUGH_PORTS), go to IP pass's router unless reserved"
			if [ "$sub" = allow ]; then v=$(add_list "$v" "$t"); else v=$(del_list "$v" "$t"); fi
		done
		keep "$CONF"
		set_conf FORWARD_ALLOW_LOW "$v"
		write_conf
		kept
		nat_apply
		say "FORWARD_ALLOW_LOW=\"$v\""
		if [ "$sub" = allow ]; then
			for t in "$@"; do allow_note "$t"; done
		fi
		;;
	reserve | unreserve)
		tokens "$@"
		shift
		check_proto
		lock
		for t in "$@"; do
			if always_reserved "$t"; then
				[ "$sub" = reserve ] || die "$t: SSH and cengarde are always reserved"
			fi
			v=${t#*:}
			if [ "$sub" = unreserve ] && [ "${v%-*}" -le 1023 ]; then
				die "$t: below 1024 it is \"forward allow\""
			fi
			if [ "$sub" = reserve ]; then
				FORWARD_RESERVED=$(add_list "$FORWARD_RESERVED" "$t")
				FORWARD_UNRESERVE=$(del_list "$FORWARD_UNRESERVE" "$t")
			else
				FORWARD_RESERVED=$(del_list "$FORWARD_RESERVED" "$t")
				FORWARD_UNRESERVE=$(add_list "$FORWARD_UNRESERVE" "$t")
			fi
		done
		keep "$CONF"
		set_conf FORWARD_RESERVED "$FORWARD_RESERVED"
		set_conf FORWARD_UNRESERVE "$FORWARD_UNRESERVE"
		write_conf
		kept
		nat_apply
		say "FORWARD_RESERVED=\"$FORWARD_RESERVED\" FORWARD_UNRESERVE=\"$FORWARD_UNRESERVE\""
		;;
	*) die "usage: forward [add|del NAME PROTO:PORT[-PORT][=TO]... | off|on NAME | limit NAME N|default | allow|disallow|reserve|unreserve PROTO:PORT[-PORT]...]" ;;
	esac
}

# behind_nat_view: what behind_nat says, changing nothing.
behind_nat_view() {
	local m a d
	m=$(main_ipv4)
	[ -n "$m" ] || return 0
	a=${m% *} d=${m#* }
	if cgnat4 "$a"; then
		echo "This server's main IPv4, $a, is in 100.64.0.0/10: probably behind carrier-grade NAT, unreachable as a server."
	elif private4 "$a"; then
		echo "This server's main IPv4, $a on $d, is private: behind a home router or a cloud with 1:1 NAT."
		echo "Open towards $a, in your home router or in the provider's firewall (security list):"
		echo "  udp $CENGARDE_PORT (cengarde)"
		if [ -e "$NAT_STATE/applied" ]; then
			awk '$1 == "dnat" { printf "  %s %s (to router %s)\n", $2, ($3 == $4 ? $3 : $3 "-" $4), $7 }' "$NAT_STATE/applied"
		fi
	fi
}

# cmd_ipv6 on|off: TUNNEL_IPV6 in nat.conf, and the engine's TUN (its
# addresses and each router's tun_route) and the firewall to match.
cmd_ipv6() {
	local v
	case ${1:-} in
	on) v=yes ;;
	off) v=no ;;
	*) die "usage: ipv6 on|off" ;;
	esac
	[ "$v" = no ] || have_v6 ||
		die "this server has no IPv6 (no $R/proc/net/if_inet6): its provider has to give it some first"
	check_proto
	lock
	keep "$CONF"
	set_conf TUNNEL_IPV6 "$v"
	regen
	kept
	if [ "$v" = yes ]; then
		say "the routers' IPv6 goes through the tunnels, masqueraded out of this server; on each router turn on \"IPv6 through the tunnel\" in LuCI (Tunnel tab)"
	else
		say "the routers' IPv6 no longer goes through the tunnels"
	fi
}

# cmd_tunnel: what "tunnel wireguard|native" did before 0.12; the engine's
# TUN is the only tunnel now (story 027).
cmd_tunnel() {
	case ${1:-} in
	native | '') say "the routers' tunnels go through the engine's TUN $TUN_DEV, the only tunnel since cengarde 0.12" ;;
	wireguard) die "WireGuard was removed in cengarde 0.12 (docs/historias/027-adios-wireguard.md): the routers' tunnels go through the engine's TUN $TUN_DEV; update each router to the same release, which does the same" ;;
	*) die "usage: tunnel [native]" ;;
	esac
}

# cmd_protocontroller on|off: PROTOCONTROLLER in nat.conf, and the engine
# to match.
cmd_protocontroller() {
	local v
	case ${1:-} in
	on) v=yes ;;
	off) v=no ;;
	*) die "usage: protocontroller on|off" ;;
	esac
	check_proto
	lock
	if [ "$PROTOCONTROLLER" = "$v" ]; then
		say "protocontroller is $1 already"
		return 0
	fi
	if [ "$v" = yes ]; then
		# BBR toward the destinations once a leg loses: the module at every boot, and now
		mkdir -p "$R/etc/modules-load.d"
		echo tcp_bbr >"$R/etc/modules-load.d/cengarde-bbr.conf"
		[ -n "$R" ] || modprobe tcp_bbr 2>/dev/null || say "modprobe tcp_bbr failed: the engine keeps the kernel's congestion control instead"
	fi
	keep "$CONF"
	set_conf PROTOCONTROLLER "$v"
	regen
	kept
	if [ "$v" = yes ]; then
		say "protocontroller on: the routers that set \"Protocontroller\" to A or B in LuCI (Tunnel tab) hand their TCP to this server, which opens it to each destination"
	else
		say "protocontroller off: the routers' TCP goes through the tunnel as packets again (set \"Protocontroller\" to No on them too, or their TCP is refused)"
	fi
}

# cmd_fec on|off: FEC in nat.conf, and the engine (restarted: its rings
# come with each session).
cmd_fec() {
	local v
	case ${1:-} in
	on) v=yes ;;
	rlc) v=rlc ;;
	off) v=no ;;
	*) die "usage: fec on|rlc|off" ;;
	esac
	check_proto
	lock
	if [ "$FEC" = "$v" ]; then
		say "fec is $1 already"
		return 0
	fi
	keep "$CONF"
	set_conf FEC "$v"
	regen
	kept
	if [ "$v" = yes ]; then
		say "fec on: the routers that turn on the repair data in LuCI (Protection tab) are rebuilt here"
	elif [ "$v" = rlc ]; then
		say "fec rlc: the routers' repairs are rebuilt here, and the download carries FEC v3's repairs (the routers need the repair data on in LuCI to rebuild them)"
	else
		say "fec off: their repairs are dropped here (turn the repair data off on them too)"
	fi
}

cmd_refresh() {
	check_proto
	lock
	write_conf
	[ "$RELOAD" = unchanged ] || say "engine: $RELOAD"
}

cmd_purge() {
	local all='' n s0='' v u
	case ${1:-} in
	'') ;;
	--all) all=1 ;;
	*) die "usage: purge [--all]" ;;
	esac
	# The units first, the admin lock after: systemd, not this script, runs
	# cengarde-nat.service's ExecStop ("cengarde-nat down"), which takes the
	# lock itself and would wait for this script until TimeoutStopSec.
	for u in cengarde-nat-check.timer cengarde-nat-check.service cengarde-passthrough.path \
		cengarde-passthrough.service cengarde-forward.path cengarde-forward.service cengarde.service \
		cengarde-nat.service; do
		systemctl disable --now "$u" 2>/dev/null || :
	done
	lock
	# Again, in case the unit was not running or its ExecStop failed.
	cengarde-nat down || warn "cengarde-nat down failed"
	rm -f "$UNITS/cengarde-nat.service" "$UNITS/cengarde-nat-check.timer" "$UNITS/cengarde-nat-check.service" \
		"$UNITS/cengarde-passthrough.path" "$UNITS/cengarde-passthrough.service" \
		"$UNITS/cengarde-forward.path" "$UNITS/cengarde-forward.service" \
		"$UNITS/nftables.service.d/cengarde.conf" "$UNITS/cengarde.service"
	rm -rf "$UNITS/cengarde.service.d"
	rmdir "$UNITS/nftables.service.d" 2>/dev/null || :
	systemctl daemon-reload 2>/dev/null || :
	# cengarde 0.4 serves one router, and its install.sh reads its secret
	# from /etc/cengarde/secret: the router in slot 0.
	for n in $(routers); do
		[ "$(kv "$CLIENTS/$n" SLOT)" = 0 ] && s0=$n
	done
	if [ -n "$s0" ]; then
		(umask 077 && kv "$CLIENTS/$s0" SECRET >"$SECRET_FILE")
		say "router $s0's secret written back to $SECRET_FILE, for cengarde 0.4's install.sh"
		[ "$(kv "$CLIENTS/$s0" TUNNEL_ADDR)" = "$LEGACY_TUNNEL" ] ||
			warn "router $s0's tunnel address is $(kv "$CLIENTS/$s0" TUNNEL_ADDR), and cengarde 0.4 serves $LEGACY_TUNNEL only: set the router's to $LEGACY_TUNNEL too (LuCI, VPS tab)"
	else
		warn "no router in slot 0: $SECRET_FILE not written"
	fi
	# Its IP pass, for 0.4's cengarde-nat: whether it holds the range (an
	# engine before 0.5.2 wrote on or off instead).
	v=
	if [ -n "$s0" ] && [ -f "$FWD_FILE" ]; then
		if grep -qx "pass $s0" "$FWD_FILE"; then v=on; else v=off; fi
	elif [ -f "$PASS_FILE" ]; then
		v=$(head -n 1 "$PASS_FILE" 2>/dev/null || :)
	fi
	if [ "$v" = on ] || [ "$v" = off ]; then
		mkdir -p "${OLD_PASS%/*}"
		echo "$v" >"$OLD_PASS"
	fi
	if [ -n "$all" ]; then
		rm -rf "$CLIENTS" "$STATE_DIR" "$NAT_STATE"
		rm -f "$IDLE_KEY" "$SYSUSERS"
		userdel "$ENGINE_USER" 2>/dev/null || :
		say "routers and the engine's state removed"
	fi
	say "purged. Back to cengarde 0.4: check out its commit, then run its contrib/vps/install.sh"
}

case "${1:-}" in
'') cmd_default ;;
add)
	shift
	cmd_add "$@"
	;;
remove)
	shift
	cmd_remove "$@"
	;;
list) cmd_list ;;
forward)
	shift
	cmd_forward "$@"
	;;
ipv6)
	shift
	cmd_ipv6 "$@"
	;;
tunnel)
	shift
	cmd_tunnel "$@"
	;;
protocontroller)
	shift
	cmd_protocontroller "$@"
	;;
fec)
	shift
	cmd_fec "$@"
	;;
refresh) cmd_refresh ;;
purge)
	shift
	cmd_purge "$@"
	;;
-h | --help | help) sed -n '2,/^# SPDX/p' "$0" | sed 's/^# \{0,1\}//' ;;
*) die "unknown command $1 (cengarde-vps-setup --help)" ;;
esac
