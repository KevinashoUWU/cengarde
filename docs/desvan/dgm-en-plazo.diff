+/* A datagram's links in time (cg_eta_within): those within the window of
+ * the first, nothing put anywhere; a link of no rate is in. */
+static void test_eta_within(void)
+{
+	struct cg_eta e;
+
+	cg_eta_reset(&e);
+	CHECK_EQ(cg_eta_within(&e, 0x3, 1000, 0, 100 * MS), 0x3); /* no rate: every link */
+	cg_eta_set(&e, 0, 8000000, 0, 0, 0);          /* 1 ms */
+	cg_eta_set(&e, 1, 8000000, 50 * MS, 0, 0);    /* 51 ms */
+	cg_eta_set(&e, 2, 8000000, 20 * MS, 300 * MS, 0); /* a 300 ms queue: 321 ms */
+	CHECK_EQ(cg_eta_within(&e, 0x7, 1000, 0, 100 * MS), 0x3);
+	CHECK_EQ(e.l[0].backlog, 0); /* nothing put */
+	CHECK_EQ(cg_eta_within(&e, 0x7, 1000, 0, 400 * MS), 0x7);
+	CHECK_EQ(cg_eta_within(&e, 0x4, 1000, 0, 100 * MS), 0x4); /* the first is always in */
+	CHECK_EQ(cg_eta_within(&e, 0xd, 1000, 0, 100 * MS), 0x9); /* link 3, no rate, in */
+	CHECK_EQ(cg_eta_within(&e, 0, 1000, 0, 100 * MS), 0);
+}
