+/* The links of set where a packet of len bytes put now arrives within
+ * window_us of the first of them, without putting it anywhere: an
+ * unreliable datagram's useful links (a DGM, story 031: one that comes
+ * later than its receiver's jitter buffer is lost all the same, and on a
+ * link behind a long queue it only lengthens that queue). A link without
+ * a rate is in; with set holding one, the first always is. */
+static inline uint16_t cg_eta_within(struct cg_eta *e, uint16_t set, uint32_t len, uint64_t now_us, uint32_t window_us)
+{
+	uint64_t at[CG_MAX_LINKS], best = UINT64_MAX, bits = (uint64_t)len * 8 * 1000000;
+	uint16_t out = 0;
+
+	for (unsigned i = 0; i < CG_MAX_LINKS; i++) {
+		struct cg_eta_link *l = &e->l[i];
+
+		if (!(set >> i & 1))
+			continue;
+		if (!l->bps) {
+			out |= (uint16_t)(1u << i);
+			continue;
+		}
+		cg_eta_drain(l, now_us);
+		at[i] = l->base_us + (l->backlog + bits) / l->bps;
+		if (at[i] < best)
+			best = at[i];
+	}
+	for (unsigned i = 0; best != UINT64_MAX && i < CG_MAX_LINKS; i++)
+		if ((set >> i & 1) && e->l[i].bps && at[i] - best <= window_us)
+			out |= (uint16_t)(1u << i);
+	return out;
+}
